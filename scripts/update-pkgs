#!/usr/bin/env bash
# Checks pkgs/*.nix against upstream and, with --apply, bumps version/rev and
# refetches the source hash in place. Skips crush (checked manually).
set -euo pipefail

root_dir="$(git rev-parse --show-toplevel)"
pkgs_dir="$root_dir/pkgs"

apply=false
only=()

usage() {
  cat <<'EOF'
usage: update-pkgs [--apply] [package...]

Packages: claude-desktop helium-browser
With no package names, checks all of the above.

  --apply   Write the new version/rev and refetch the source hash for any
            package found outdated. zed-editor's cargoHash still needs a
            manual rebuild afterwards to learn the new hash (see the note
            printed after applying).
EOF
}

for arg in "$@"; do
  case "$arg" in
    -a | --apply) apply=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) only+=("$arg") ;;
  esac
done

wanted() {
  [[ ${#only[@]} -eq 0 ]] && return 0
  for name in "${only[@]}"; do
    [[ "$name" == "$1" ]] && return 0
  done
  return 1
}

gh_api() {
  local url="$1"
  local auth=()
  [[ -n "${GITHUB_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
  curl -sf "${auth[@]}" -H "Accept: application/vnd.github+json" "$url"
}

report() {
  # name current latest status
  printf '%-16s %-22s %-22s %s\n' "$1" "$2" "$3" "$4"
}

header_printed=false
print_header() {
  $header_printed && return
  report PACKAGE CURRENT LATEST STATUS
  header_printed=true
}

# ---- claude-desktop --------------------------------------------------------

check_claude_desktop() {
  wanted claude-desktop || return 0
  local file="$pkgs_dir/claude-desktop.nix"
  local cur_version packages latest_version latest_sha256

  cur_version=$(grep -m1 '^\s*version = ' "$file" | sed -E 's/.*"(.*)".*/\1/')

  # The apt Packages index carries the SHA256 of every .deb, so the SRI hash
  # can be derived without downloading the ~140MB archive.
  packages=$(curl -sfL "https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages")
  latest_version=$(grep -E '^Version: ' <<<"$packages" | awk '{print $2}' | sort -V | tail -1)

  print_header
  if [[ "$cur_version" == "$latest_version" ]]; then
    report claude-desktop "$cur_version" "$latest_version" "up to date"
    return 0
  fi
  report claude-desktop "$cur_version" "$latest_version" "UPDATE AVAILABLE"

  $apply || return 0
  latest_sha256=$(awk -v ver="$latest_version" '
    /^Version: / { v = $2 }
    /^SHA256: / { if (v == ver) print $2 }
  ' <<<"$packages" | head -1)
  local hash
  hash=$(nix hash convert --hash-algo sha256 --to sri "$latest_sha256")
  sed -i \
    -e "s/version = \"${cur_version}\"/version = \"${latest_version}\"/" \
    -e "s#hash = \"sha256-[^\"]*\"#hash = \"${hash}\"#" \
    "$file"
  echo "  applied: claude-desktop -> ${latest_version}"
}

# ---- helium-browser ---------------------------------------------------------

check_helium_browser() {
  wanted helium-browser || return 0
  local file="$pkgs_dir/helium-browser.nix"
  local cur_version api_json latest_version

  cur_version=$(grep -m1 '^\s*version = ' "$file" | sed -E 's/.*"(.*)".*/\1/')

  # GitHub release assets carry sha256 digests, so the SRI hashes for both
  # arches can be derived without downloading the ~160MB .debs.
  api_json=$(gh_api "https://api.github.com/repos/imputnet/helium-linux/releases/latest")
  latest_version=$(jq -r .tag_name <<<"$api_json")

  print_header
  if [[ "$cur_version" == "$latest_version" ]]; then
    report helium-browser "$cur_version" "$latest_version" "up to date"
    return 0
  fi
  report helium-browser "$cur_version" "$latest_version" "UPDATE AVAILABLE"

  $apply || return 0
  local arch digest hash
  for arch in amd64 arm64; do
    digest=$(jq -r --arg name "helium-bin_${latest_version}-1_${arch}.deb" \
      '.assets[] | select(.name == $name) | .digest' <<<"$api_json")
    [[ "$digest" == sha256:* ]] || {
      echo "  error: no sha256 digest for ${arch} asset"
      return 1
    }
    hash=$(nix hash convert --hash-algo sha256 --to sri "${digest#sha256:}")
    sed -i \
      -e "/debArch = \"${arch}\";/{n;s#hash = \"sha256-[^\"]*\"#hash = \"${hash}\"#;}" \
      "$file"
  done
  sed -i "s/version = \"${cur_version}\"/version = \"${latest_version}\"/" "$file"
  echo "  applied: helium-browser -> ${latest_version}"
}

check_claude_desktop
check_helium_browser

echo
echo "skipped: crush (checked manually)"
