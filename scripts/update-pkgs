#!/usr/bin/env bash
# Checks pkgs/*.nix against upstream and, with --apply, bumps version/rev and
# refetches the source hash in place. Skips claude-desktop and crush (checked
# manually).
set -euo pipefail

root_dir="$(git rev-parse --show-toplevel)"
pkgs_dir="$root_dir/pkgs"

apply=false
only=()

usage() {
  cat <<'EOF'
usage: update-pkgs [--apply] [package...]

Packages: code-cursor sweet-cursors zed-editor
With no package names, checks all of the above.

  --apply   Write the new version/rev and refetch the source hash for any
            package found outdated. zed-editor's cargoHash still needs a
            manual rebuild afterwards to learn the new hash (see the note
            printed after applying).
EOF
}

for arg in "$@"; do
  case "$arg" in
    -a | --apply) apply=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) only+=("$arg") ;;
  esac
done

wanted() {
  [[ ${#only[@]} -eq 0 ]] && return 0
  for name in "${only[@]}"; do
    [[ "$name" == "$1" ]] && return 0
  done
  return 1
}

gh_api() {
  local url="$1"
  local auth=()
  [[ -n "${GITHUB_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
  curl -sf "${auth[@]}" -H "Accept: application/vnd.github+json" "$url"
}

prefetch_github_hash() {
  # owner repo rev -> sha256-... SRI hash, matching fetchFromGitHub's hash
  nix run nixpkgs#nix-prefetch-github -- "$1" "$2" --rev "$3" 2>/dev/null | jq -r .hash
}

prefetch_url_hash() {
  nix store prefetch-file --json --hash-type sha256 "$1" 2>/dev/null | jq -r .hash
}

report() {
  # name current latest status
  printf '%-16s %-22s %-22s %s\n' "$1" "$2" "$3" "$4"
}

header_printed=false
print_header() {
  $header_printed && return
  report PACKAGE CURRENT LATEST STATUS
  header_printed=true
}

# ---- code-cursor -----------------------------------------------------------

check_code_cursor() {
  wanted code-cursor || return 0
  local file="$pkgs_dir/code-cursor.nix"
  local cur_version cur_commit api_json latest_version latest_commit download_url

  cur_version=$(grep -m1 '^\s*version = ' "$file" | sed -E 's/.*"(.*)".*/\1/')
  cur_commit=$(grep -m1 '^\s*commit = ' "$file" | sed -E 's/.*"(.*)".*/\1/')

  api_json=$(curl -sfL "https://www.cursor.com/api/download?platform=linux-x64&releaseTrack=stable")
  download_url=$(jq -r .downloadUrl <<<"$api_json")
  latest_version=$(jq -r .downloadUrl <<<"$api_json" | grep -oE 'Cursor-[0-9.]+-x86_64' | sed -E 's/Cursor-(.*)-x86_64/\1/')
  latest_commit=$(grep -oE 'production/[0-9a-f]{40}' <<<"$download_url" | cut -d/ -f2)

  print_header
  if [[ "$cur_version" == "$latest_version" && "$cur_commit" == "$latest_commit" ]]; then
    report code-cursor "$cur_version" "$latest_version" "up to date"
    return 0
  fi
  report code-cursor "$cur_version" "$latest_version" "UPDATE AVAILABLE"

  $apply || return 0
  local hash
  hash=$(prefetch_url_hash "$download_url")
  sed -i \
    -e "s/version = \"${cur_version}\"/version = \"${latest_version}\"/" \
    -e "s/commit = \"${cur_commit}\"/commit = \"${latest_commit}\"/" \
    -e "s#hash = \"sha256-[^\"]*\"#hash = \"${hash}\"#" \
    "$file"
  echo "  applied: code-cursor -> ${latest_version} (${latest_commit})"
}

# ---- sweet-cursors ------------------------------------------------------------

check_sweet_cursors() {
  wanted sweet-cursors || return 0
  local file="$pkgs_dir/sweet-cursors.nix"
  local cur_rev latest_rev latest_date latest_version commit_json

  cur_rev=$(grep -m1 '^\s*rev = ' "$file" | sed -E 's/.*"(.*)".*/\1/')
  commit_json=$(gh_api "https://api.github.com/repos/EliverLara/Sweet/commits/nova")
  latest_rev=$(jq -r .sha <<<"$commit_json")
  latest_date=$(jq -r '.commit.committer.date' <<<"$commit_json" | cut -dT -f1)
  latest_version="unstable-${latest_date}"

  print_header
  if [[ "$cur_rev" == "$latest_rev" ]]; then
    report sweet-cursors "${cur_rev:0:12}" "${latest_rev:0:12}" "up to date"
    return 0
  fi
  report sweet-cursors "${cur_rev:0:12}" "${latest_rev:0:12}" "UPDATE AVAILABLE"

  $apply || return 0
  local hash
  hash=$(prefetch_github_hash EliverLara Sweet "$latest_rev")
  sed -i \
    -e "s/version = \"unstable-[0-9-]*\"/version = \"${latest_version}\"/" \
    -e "s/rev = \"${cur_rev}\"/rev = \"${latest_rev}\"/" \
    -e "s#hash = \"sha256-[^\"]*\"#hash = \"${hash}\"#" \
    "$file"
  echo "  applied: sweet-cursors -> ${latest_version} (${latest_rev:0:12})"
}

# ---- zed-editor ---------------------------------------------------------------

check_zed_editor() {
  wanted zed-editor || return 0
  local file="$pkgs_dir/zed-editor.nix"
  local cur_version latest_tag latest_version

  cur_version=$(grep -m1 '^\s*version = ' "$file" | sed -E 's/.*"(.*)".*/\1/')
  latest_tag=$(
    gh_api "https://api.github.com/repos/zed-industries/zed/releases?per_page=20" |
      jq -r '.[] | select(.prerelease == false and .draft == false) | .tag_name' |
      grep -vE '(0\.999999\.0|0\.9999-temporary)$' |
      head -1
  )
  latest_version="${latest_tag#v}"

  print_header
  if [[ "$cur_version" == "$latest_version" ]]; then
    report zed-editor "$cur_version" "$latest_version" "up to date"
    return 0
  fi
  report zed-editor "$cur_version" "$latest_version" "UPDATE AVAILABLE"

  $apply || return 0
  local hash
  hash=$(prefetch_github_hash zed-industries zed "$latest_tag")
  sed -i \
    -e "s/version = \"${cur_version}\"/version = \"${latest_version}\"/" \
    -e "s#hash = \"sha256-[^\"]*\"#hash = \"${hash}\"#" \
    "$file"
  echo "  applied: zed-editor -> ${latest_version}"
  echo "  NOTE: cargoHash is now stale. Set it to lib.fakeHash, run"
  echo "        'nix build .#nixosConfigurations.<host>...' (or any build that"
  echo "        pulls zed-editor), and copy the 'got:' hash from the error."
}

check_code_cursor
check_sweet_cursors
check_zed_editor

echo
echo "skipped: claude-desktop, crush (checked manually)"
