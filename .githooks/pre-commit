#!/usr/bin/env bash
set -euo pipefail

root_dir="$(git rev-parse --show-toplevel)"
cd "$root_dir"

staged_nix_files=()
while IFS= read -r path; do
  staged_nix_files+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.nix')

if [ "${#staged_nix_files[@]}" -eq 0 ]; then
  exit 0
fi

echo "Formatting staged Nix files"
nix fmt -- "${staged_nix_files[@]}"

has_partial=false
for file in "${staged_nix_files[@]}"; do
  if git diff -- "$file" | grep -q .; then
    has_partial=true
    break
  fi
done

if [ "$has_partial" = true ]; then
  echo "Note: partial staging detected — skipping restage to preserve hunks"
  echo "Run 'git add' manually if formatting changed staged lines"
else
  git add -- "${staged_nix_files[@]}"
fi
